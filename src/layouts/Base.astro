---
import '../styles/global.css';
import Background from '../components/Background.astro';
import Head from '../components/Head.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { getSite } from '../lib/content';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
}

const project = await getSite();
const { title, description = project.title } = Astro.props;
const pageTitle = title ? `${title} · ${project.name}` : project.name;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '');

const nav = [
  { label: 'Status', href: '/status/' },
  { label: 'Meetings', href: '/meetings/' },
  { label: 'Team', href: '/team/' },
  { label: 'Docs', href: '/docs/agents/', section: '/docs/' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={pageTitle} description={description} />
  </head>
  <body>
    <Background />
    <div class="page">
      <header class="header">
        <a href={url('/')} class="brand">
          {project.name}
        </a>
        <nav class="nav">
          {nav.map((item) => (
            <a href={url(item.href)} class:list={{ active: path.startsWith(item.section ?? item.href) }}>
              {item.label}
            </a>
          ))}
          <a href={project.github}>GitHub</a>
          <ThemeToggle />
        </nav>
      </header>
      <main class="main">
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .brand {
    font-weight: 600;
    font-size: 17px;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 24px;
    font-size: 15px;
  }

  .nav a {
    color: var(--muted);
  }

  .nav a:hover,
  .nav a.active {
    color: var(--ink);
  }

  .main {
    display: flex;
    flex-direction: column;
    gap: 52px;
  }

  @media (max-width: 560px) {
    .header {
      flex-wrap: wrap;
      row-gap: 12px;
    }

    .nav {
      gap: 16px;
      font-size: 14px;
    }

    .main {
      gap: 40px;
    }
  }
</style>
